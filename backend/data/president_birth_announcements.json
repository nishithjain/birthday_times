{
    "schemaVersion": 1,
    "description": "Personalized presidential birth-announcement copy for Birthday Chronicles. President identity is supplied dynamically from us_presidents.json and birthday/calendar values are supplied dynamically by ChronicleService and CalendarService.",
    "accuracyType": "personalized",
    "fictionalized": true,
    "presidentSource": "backend/data/us_presidents.json",
    "selection": {
        "source": "newspaperStyleId",
        "fallbackTemplateId": "classic_1950",
        "styleTemplateMap": {
            "1950": "classic_1950",
            "1960": "classic_1960",
            "1970": "vintage_1970",
            "1980": "vintage_1980",
            "1990": "modern_1990",
            "1995": "modern_1995",
            "2000": "modern_2000",
            "2005": "modern_2005",
            "2010": "contemporary_2010",
            "2015": "contemporary_2015"
        }
    },
    "placeholders": {
        "personName": "Full name entered by the user",
        "personFirstName": "First name derived from the user's entered name",
        "personNameUpper": "Full user name converted to uppercase",
        "personFirstNameUpper": "First name converted to uppercase",
        "presidentName": "Full president name returned by PresidentService",
        "presidentLastName": "Surname of the selected president",
        "presidentLastNameUpper": "President surname converted to uppercase",
        "presidentNumber": "President number for the applicable term",
        "birthDateLong": "Example: Sunday, May 9, 1982",
        "birthDateMedium": "Example: May 9, 1982",
        "birthDateShortUpper": "Example: MAY 9, 1982",
        "dayOfWeek": "Example: Sunday",
        "dayOfWeekUpper": "Example: SUNDAY",
        "birthYear": "Example: 1982",
        "birthMonthName": "Example: May",
        "birthMonthNameUpper": "Example: MAY",
        "birthDay": "Example: 9",
        "westernZodiac": "Example: Taurus",
        "chineseZodiac": "Example: Dog",
        "birthstone": "Example: Emerald",
        "birthFlower": "Example: Lily of the Valley",
        "birthFlowerPlural": "Display-ready plural or natural flower name"
    },
    "commonLabels": {
        "presidentCaption": "PRESIDENT OF THE UNITED STATES",
        "personalizedNotice": "PERSONALIZED BIRTHDAY EDITION"
    },
    "templates": [
        {
            "id": "classic_1950",
            "newspaperStyleId": "1950",
            "style": "classic",
            "tone": "formal_vintage",
            "headlineTemplate": "PRESIDENT {presidentLastNameUpper} NOTES BIRTH OF",
            "nameTemplate": "{personNameUpper}",
            "subheadlineTemplate": "NEWS OF ARRIVAL REACHES WHITE HOUSE",
            "datelineTemplate": "WASHINGTON —",
            "paragraphs": [
                {
                    "id": "arrival",
                    "template": "The President of the United States, {presidentName}, was serving in the White House when {personName} was born on {birthDateLong}. The happy arrival adds a personal headline to the memorable events of {birthYear}.",
                    "requires": [
                        "presidentName",
                        "personName",
                        "birthDateLong",
                        "birthYear"
                    ]
                },
                {
                    "id": "birthday_symbols",
                    "template": "Born under the sign of {westernZodiac}, {personFirstName} arrived on a {dayOfWeek}, with {birthstone} traditionally associated with birthdays in {birthMonthName}.",
                    "requires": [
                        "personFirstName",
                        "westernZodiac",
                        "dayOfWeek",
                        "birthstone",
                        "birthMonthName"
                    ]
                },
                {
                    "id": "birth_flower",
                    "template": "A bouquet of {birthFlowerPlural}, the traditional flower associated with {birthMonthName}, would make a fitting welcome for the newest arrival.",
                    "requires": [
                        "birthFlowerPlural",
                        "birthMonthName"
                    ]
                }
            ]
        },
